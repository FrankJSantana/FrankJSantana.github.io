---
import ServiceCard from "./ServiceCard.astro";
import { FaLaptopCode, FaDatabase, FaServer } from "react-icons/fa";
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
	<h2
		class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-end"
	>
		<span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"></span>
		<span class="drop-shadow-[2px_2px_0_#7836cf]">Servicios</span>
	</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		<ServiceCard
			icon={FaDatabase}
			title="Ingeniería de Datos"
			description="Diseño de pipelines ETL con Python, SQL y Apache Spark, orquestación con Airflow y despliegue en la nube con AWS."
		/>
		<ServiceCard
			icon={FaServer}
			title="Backend"
			description="APIs REST y microservicios con Java y Spring Boot, bases de datos relacionales y buenas prácticas de calidad y testing."
		/>
		<ServiceCard
			icon={FaLaptopCode}
			title="Desarrollo Web y Móvil"
			description="Aplicaciones web responsivas y apps móviles Full Stack con React, React Native y Node.js."
		/>
	</div>
</section>
